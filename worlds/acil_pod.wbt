#VRML_SIM R2025a utf8
# ACIL-POD educational simulation, not certified rescue equipment.
# ENU: local +X forward, +Y left, +Z up. All wheel positive motor velocities drive forward.
# Wheel radius: 0.065 m. lid_motor/lid_sensor in radians: 0 closed, +1.22 upper limit.
# front_sensor: one forward +X ray; identity lookup, 0..2 m. 2 m is saturation/no closer hit.
# Entire world uses built-in Webots nodes; no external assets are required.

WorldInfo {
  title "ACIL-POD | Classroom demo"
  info [ "Classroom rescue-pod demonstration" "Drive forward, stop on obstacle detection, then open the orange pod lid." ]
  basicTimeStep 32
  coordinateSystem "ENU"
}
Viewpoint { position 3 -3.35 2.55 orientation -.25342932 .11324458 .96070247 2.33059741 fieldOfView 0.72 }
Background { skyColor [ 0.085 0.125 0.17 ] }
DirectionalLight { direction -0.6 0.6 -1 intensity 1.35 ambientIntensity 0.4 castShadows TRUE }
DirectionalLight { direction 0.65 -0.2 -0.55 color 0.69 0.81 1 intensity 0.62 }

Solid {
  name "arena floor"
  translation 0 0 -0.045
  children [
    Shape { appearance PBRAppearance { baseColor .212 .271 .323 roughness 0.92 metalness 0 } geometry Box { size 4.8 3.5 0.09 } }
    
  ]
  boundingObject Box { size 4.8 3.5 0.09 }
}

Solid {
  name "left boundary"
  translation 0 1.74 .045
  children [
    Shape { appearance PBRAppearance { baseColor .46 .53 .59 roughness 0.7 metalness 0.12 } geometry Box { size 4.8 .06 .09 } }
    
  ]
  boundingObject Box { size 4.8 .06 .09 }
}

Solid {
  name "right boundary"
  translation 0 -1.74 .045
  children [
    Shape { appearance PBRAppearance { baseColor .46 .53 .59 roughness 0.7 metalness 0.12 } geometry Box { size 4.8 .06 .09 } }
    
  ]
  boundingObject Box { size 4.8 .06 .09 }
}

Solid {
  name "back boundary"
  translation -2.37 0 .045
  children [
    Shape { appearance PBRAppearance { baseColor .46 .53 .59 roughness 0.7 metalness 0.12 } geometry Box { size .06 3.42 .09 } }
    
  ]
  boundingObject Box { size .06 3.42 .09 }
}

Solid {
  name "front boundary"
  translation 2.37 0 .045
  children [
    Shape { appearance PBRAppearance { baseColor .46 .53 .59 roughness 0.7 metalness 0.12 } geometry Box { size .06 3.42 .09 } }
    
  ]
  boundingObject Box { size .06 3.42 .09 }
}

# Decorative non-colliding lane markings and obstacle approach pad.

Pose { translation -.05 .43 .0006 children [ Shape { appearance PBRAppearance { baseColor .34 .61 .71 roughness 0.75 metalness 0 } geometry Box { size 3.85 .025 .0012 } } ] }

Pose { translation -.05 -.43 .0006 children [ Shape { appearance PBRAppearance { baseColor .34 .61 .71 roughness 0.75 metalness 0 } geometry Box { size 3.85 .025 .0012 } } ] }

